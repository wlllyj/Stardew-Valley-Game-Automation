  "meta": {
    "version": "1.6",
    "currency": "g",
    "season_days": 28
  },
  "comment": "星露谷物语作物经济数据库。profit_per_day = (售价 - 种子成本) / 生长天数，不考虑加工与肥料。多收作物按期望产出折算。数据基于 1.6 版本，不随时间衰败的作物按 1 季 28 天计算。",
  "season_strategy": {
    "spring": {
      "best_crop": "Strawberry",
      "strategy": "春季前 12 天种土豆/防风草快速回本并升级工具；13 日彩蛋节把所有钱换成草莓种子，立刻种下。草莓是春季绝对最优，且可留作温室与次年种子。"
    },
    "summer": {
      "best_crop": "Starfruit",
      "strategy": "前期无沙漠通道时，蓝莓是纯粹性价比之王（低成本、多收、易自动化）。解锁沙漠后，大量杨桃 + 酿酒桶是夏季与温室的最强组合。啤酒花适合啤酒桶流水线。"
    },
    "fall": {
      "best_crop": "Cranberry",
      "strategy": "蔓越莓是秋季最优解——高利润、多收、一次种下收整季，完美适配自动收获。南瓜做巨型作物（3x3 概率）。若旅行商人出稀有种子，优先买下种在温室。"
    },
    "winter": {
      "best_crop": null,
      "strategy": "冬季无法户外种植。核心任务转向：①下矿刷矿（铱矿/火山锻炉升级工具）；②温室与姜岛农场全力运转；③社区中心献祭补齐；④钓鱼升级；⑤建造更多酿酒桶/罐头瓶产线。冬季是设施建设期，不是收入期。"
    }
  },
