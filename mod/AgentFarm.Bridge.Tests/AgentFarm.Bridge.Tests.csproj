<Project Sdk="Microsoft.NET.Sdk">

  <!--
    task-182 必修 4（GAP-1）：把 ClumpRules.Ready 的判据"行为化"的极小 C# 自检工程。

    为什么需要它
      `CropMeta.Ready(HoeDirt, Crop)` 吃游戏类型，仓库里没有 C# 测试工程 ⇒ 旧的"契约用例"
      只能做源码文本存在性断言。task-178 对抗验收实测：变异体在游戏中转之后插一句
      `return (null, null);`（fail-closed 过头），5 条文本用例全绿逃逸。
      现在判据本体搬进 `ClumpRules.cs`（纯函数、不引用任何游戏类型），本工程**只编译它**
      ⇒ 可以真正 `dotnet run` 跑行为断言，退出码非 0 即红。

    为什么不用 xunit / NuGet
      离线环境与"不引入任何 NuGet 包"的项目纪律（见 AgentFarm.Bridge.csproj 注释）。
      纯控制台 + 手写断言：零包依赖、构建 <2 秒。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AgentFarm.Bridge.Tests</AssemblyName>
    <RootNamespace>AgentFarm.Bridge.Tests</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- 判据本体：与 Mod 编译的是同一个文件（不是拷贝），变异打在哪，这里就红在哪。 -->
    <Compile Include="..\AgentFarm.Bridge\ClumpRules.cs" />
    <!-- task-199：坐标列表的排序/截断是纯逻辑 ⇒ 自检工程直接编译同一份源码跑行为断言。 -->
    <Compile Include="..\AgentFarm.Bridge\TileListRules.cs" />
    <!-- task-208：`dismiss_modal` 的显式应答选择（下标/文本子串/歧义）是纯逻辑 ⇒ 同样直接编译。 -->
    <Compile Include="..\AgentFarm.Bridge\AnswerRules.cs" />
    <!-- task-205：铁匠铺升级链的判据（买前自检顺序 / 条目唯一选择 / 证据优先级）是纯逻辑
         ⇒ 同样直接编译同一份源码。判据本体留在吃游戏类型的 ToolUpgradeSkill 里就只能做
         源码文本断言（task-182 的 GAP-1 教训：文本断言逃逸了行为变异）。 -->
    <Compile Include="..\AgentFarm.Bridge\ToolUpgradeRules.cs" />
    <!-- task-213：内省面（表名归一 / limit 钳制 / key 匹配 / 差集 / 值渲染）是纯逻辑
         ⇒ 同样直接编译同一份源码跑行为断言（Furnace 配方取证的判据必须行为化）。 -->
    <Compile Include="..\AgentFarm.Bridge\DumpRules.cs" />
    <!-- task-210：机器链的纯规则（配方名解析 / 背包找物 / 投料取货分类 / 证据优先级 /
         能不能再放一件）⇒ 同样直接编译同一份源码跑行为断言。技能本体吃游戏类型，
         判据留在技能里就只能做源码文本断言（task-182 GAP-1 教训）。 -->
    <Compile Include="..\AgentFarm.Bridge\MachineRules.cs" />
    <!-- task-216 / 0.7.38 结构性护栏：技能名的唯一权威表（KnownSkills 与 IsLongTaskSkill
         都从它派生）。0.7.37 装机版的事故是"Create 加了 case、KnownSkills 白名单没跟上 ⇒
         请求在进主线程前就被拒成 unknown_skill"。本工程编译同一份源码，并读 Skills.cs /
         BridgeHost.cs 的源码文本做**双向**校验（`t216_create_cases_match_catalog`
         与 `t216_consumers_delegate_to_catalog`）⇒ 以后每次 build 都自动防再犯。 -->
    <Compile Include="..\AgentFarm.Bridge\SkillCatalog.cs" />
    <!-- task-228：事件对话推进的纯规则（maxSteps 钳制 / fail-closed 前置顺序 / progress 分类 /
         事件 pause 的重试策略 / 连续 stalled 的放弃阈值）⇒ 同样直接编译同一份源码跑行为断言。
         技能本体吃 DialogueBox/Game1 类型，判据留在技能里就只能做源码文本断言（task-182 GAP-1 教训）。 -->
    <Compile Include="..\AgentFarm.Bridge\DialogueAdvanceRules.cs" />
    <!-- task-240：种子季节判定（"有种子" ≠ "当季能种"）是纯逻辑 ⇒ 直接编译同一份源码跑行为断言；
         0.7.41 冒烟 day1 的 `stuck` 就是这条判据缺失（小麦冬季不可种、守卫却一直说该去种）。 -->
    <Compile Include="..\AgentFarm.Bridge\SeedRules.cs" />
    <!-- task-245：`ui.eventId` 的三态归一（没有事件 ⇒ null / 有事件但读不到 id ⇒ null /
         有 id ⇒ 去空白）是纯逻辑 ⇒ 直接编译同一份源码跑行为断言。
         ReadUi 吃 Game1.currentEvent，判据留在那里就只能做源码文本断言（task-182 GAP-1 教训）。 -->
    <Compile Include="..\AgentFarm.Bridge\EventRules.cs" />
  </ItemGroup>

</Project>
