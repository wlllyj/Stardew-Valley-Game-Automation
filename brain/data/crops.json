  "year_roadmap": {
    "_comment": "三年综合效率最优路线图",
    "year_1": {
      "spring": "第1-12天：种防风草+土豆回本，砍树攒木材，钓鱼赚钱。第13天彩蛋节：全部资金买草莓种子并立刻种下（8天成熟后可收3次）。同步升级锄头与水壶。",
      "summer": "蓝莓铺满农场（低成本高回报），建 20+ 罐头瓶做蓝莓果酱。推进社区中心工艺室+储藏室。攒钱买鸡舍。",
      "fall": "蔓越莓全覆盖。全力推进社区中心，目标拿下温室。建造第一批酿酒桶。开始送礼给 NPC（重点：村长、木匠）。",
      "winter": "温室到手则种杨桃。下矿刷矿升级工具至铱级。建造大量酿酒桶。完成剩余献祭。备耕来年。"
    },
    "year_2": {
      "spring": "温室种杨桃+草莓。户外种草莓。酿酒桶规模上到 100+。优先完成社区中心剩余部分。",
      "summer": "解锁沙漠后大量种杨桃（户外8x8区域+温室）。杨桃酒流水线满负荷。",
      "fall": "蔓越莓 + 南瓜。追求巨型作物。完成社区中心，修复公共汽车。",
      "winter": "全力下矿（骷髅洞窟 + 火山地牢）。升级至铱工具。扩建动物棚。"
    },
    "year_3": {
      "focus": "姜岛开发。金核桃收集、姜岛农场（可全年种植）。自动化全覆盖（洒水器+自动抓取器+垃圾箱）。此时农场应已完全自维持，挂机即可产出。",
      "target": "农场实现零人工干预满负荷运转，日收入 5 位数。"
    }
  },
